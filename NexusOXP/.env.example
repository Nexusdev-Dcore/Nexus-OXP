# Copy this file to .env or set these values in your hosting environment.
# DO NOT commit real secrets.
NEXUSOXP_ADMIN_EMAIL=admin@gmail.com
NEXUSOXP_ADMIN_PASSWORD=ChangeThisStrongPassword123!
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=DBNEXUSOXP;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# Gmail SMTP setup for password reset emails
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=your-gmail-address@gmail.com
Smtp__Password=your-16-character-app-password
Smtp__FromName=NexusOXP
Smtp__FromAddress=your-gmail-address@gmail.com
