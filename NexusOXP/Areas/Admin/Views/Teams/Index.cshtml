@model IReadOnlyList<Team>
@{
    ViewData["Title"] = "Admin Teams";
}

<div class="dashboard-page">
    <section class="dashboard-header">
        <div class="dashboard-header-content">
            <div>
                <span class="section-label">Admin</span>
                <h1>Teams</h1>
                <p>All teams and their current project membership.</p>
            </div>
            <div class="dashboard-header-actions">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i>
                    Admin
                </a>
            </div>
        </div>
    </section>

    <section class="dashboard-section">
        <div class="dashboard-card table-responsive">
            <table class="table dashboard-table align-middle">
                <thead>
                    <tr>
                        <th>Team</th>
                        <th>Manager</th>
                        <th>Members</th>
                        <th>Projects</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Model)
                    {
                        <tr>
                            <td>@team.Name</td>
                            <td>@team.Manager.FirstName @team.Manager.LastName</td>
                            <td>@team.Members.Count</td>
                            <td>@team.Projects.Count</td>
                            <td class="text-end">
                                <a asp-area="" asp-controller="Teams" asp-action="Details" asp-route-id="@team.Id" class="btn btn-sm btn-outline-primary">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
