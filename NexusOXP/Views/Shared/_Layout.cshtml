@inject NexusOXP.Data.ApplicationDbContext NotificationDb
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    var unreadNotificationCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var notificationUserId = UserManager.GetUserId(User);
        if (notificationUserId is not null)
        {
            unreadNotificationCount = await NotificationDb.Notifications
                .CountAsync(notification => notification.UserId == notificationUserId && !notification.IsRead);
        }
    }
}
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - NexusOXP
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Main Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />

    <!-- Application Generated CSS -->
    <link rel="stylesheet"
          href="~/NexusOXP.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- =========================
         NAVBAR
         ========================= -->

    <header>

        <nav class="navbar navbar-expand-lg">

            <div class="container">

                <!-- Logo -->

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-mark">
                        N
                    </span>

                    <span class="brand-name">
                        NexusOXP
                    </span>

                </a>


                <!-- Mobile Toggle -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">

                                About

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">

                                Contact

                            </a>

                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Search"
                                   asp-action="Index">

                                    Search

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Projects"
                                   asp-action="Index">

                                    Projects

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Tasks"
                                   asp-action="Board">

                                    Board

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Teams"
                                   asp-action="Index">

                                    Teams

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="ActivityLogs"
                                   asp-action="Index">

                                    Activity

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link notification-nav-link"
                                   asp-controller="Notifications"
                                   asp-action="Index">

                                    Notifications

                                    @if (unreadNotificationCount > 0)
                                    {
                                        <span class="notification-badge">
                                            @unreadNotificationCount
                                        </span>
                                    }

                                </a>

                            </li>

                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Dashboard"
                                       asp-action="Index">

                                        Admin

                                    </a>

                                </li>
                            }
                        }

                    </ul>


                    <!-- Authentication -->

                    <div class="navbar-actions">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-link nav-login"
                               asp-controller="Dashboard"
                               asp-action="Index">

                                Dashboard

                            </a>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-primary nav-signup">

                                    Sign Out

                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="btn btn-link nav-login"
                               asp-controller="Account"
                               asp-action="Login">

                                Sign In

                            </a>


                            <a class="btn btn-primary nav-signup"
                               asp-controller="Account"
                               asp-action="Register">

                                Get Started

                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <main role="main">

        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="container mt-3">
                <div class="alert alert-info mb-0" role="alert">
                    @statusMessage
                </div>
            </div>
        }

        @RenderBody()

    </main>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-content">

                <div class="footer-brand">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="footer-logo">

                        NexusOXP

                    </a>

                    <p>
                        A modern platform built for simplicity,
                        performance and productivity.
                    </p>

                </div>


                <div class="footer-links">

                    <div class="footer-column">

                        <h4>Product</h4>

                        <a asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>

                        <a asp-controller="Home"
                           asp-action="About">
                            About
                        </a>

                        <a asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Projects"
                               asp-action="Index">
                                Projects
                            </a>

                            <a asp-controller="Tasks"
                               asp-action="Index">
                                Tasks
                            </a>

                            <a asp-controller="Teams"
                               asp-action="Index">
                                Teams
                            </a>

                            <a asp-controller="Notifications"
                               asp-action="Index">
                                Notifications
                            </a>

                            <a asp-controller="ActivityLogs"
                               asp-action="Index">
                                Activity
                            </a>

                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <a asp-area="Admin"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Admin
                                </a>
                            }
                        }

                    </div>


                    <div class="footer-column">

                        <h4>Account</h4>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login">
                                Sign In
                            </a>

                            <a asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        }

                    </div>


                    <div class="footer-column">

                        <h4>Legal</h4>

                        <a asp-controller="Home"
                           asp-action="Privacy">
                            Privacy
                        </a>

                        <a asp-controller="Home"
                           asp-action="Terms">
                            Terms
                        </a>

                    </div>

                </div>

            </div>


            <div class="footer-bottom">

                <span>
                    © 2026 NexusOXP. All rights reserved.
                </span>

                <span>
                    Built with ASP.NET Core MVC
                </span>

            </div>

        </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    <script src="~/js/auth.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
