@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page">

    <div class="auth-container">

        <div class="auth-card">

            <div class="auth-header">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="auth-logo">
                    YourPlatform
                </a>

                <div class="auth-icon-large">
                    <i class="bi bi-lock"></i>
                </div>

                <h1>Forgot your password?</h1>

                <p>
                    @(Model.CodeSent ? "Enter the 6-digit code from your email and choose a new password." : "Enter your email address and we'll send you a 6-digit code to reset your password.")
                </p>

            </div>

            <form method="post"
                  class="auth-form"
                  id="forgotPasswordForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">

                    <label asp-for="Email"
                           class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="you@example.com"
                           autocomplete="email"
                           readonly="@(Model.CodeSent ? "readonly" : null)" />

                    <span asp-validation-for="Email" class="field-validation-error"></span>

                </div>

                @if (Model.CodeSent)
                {
                    <div class="form-group">
                        <label class="form-label">Verification code</label>
                        <div class="d-flex justify-content-between gap-2 mb-2">
                            @for (var i = 0; i < 6; i++)
                            {
                                <input type="text"
                                       maxlength="1"
                                       inputmode="numeric"
                                       pattern="[0-9]*"
                                       class="form-control text-center otp-input"
                                       data-index="@i"
                                       style="width: 48px; height: 48px; font-size: 1.2rem;" />
                            }
                        </div>
                        <input asp-for="Code" type="hidden" id="otpCode" />
                        <span asp-validation-for="Code" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Create a new password" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your new password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                }

                <button type="submit"
                        class="btn btn-primary auth-submit">
                    @(Model.CodeSent ? "Reset Password" : "Send Code")
                </button>

            </form>

            <div class="auth-footer">

                <a asp-action="Login"
                   class="auth-back-link">

                    <i class="bi bi-arrow-left"></i>

                    Back to Sign In

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const form = document.getElementById('forgotPasswordForm');
            if (!form) return;

            const inputs = Array.from(document.querySelectorAll('.otp-input'));
            const hiddenCode = document.getElementById('otpCode');

            if (inputs.length && hiddenCode) {
                const updateHiddenCode = () => {
                    hiddenCode.value = inputs.map(input => input.value || '').join('');
                };

                inputs.forEach((input, index) => {
                    input.addEventListener('input', function () {
                        this.value = this.value.replace(/\D/g, '').slice(0, 1);
                        if (this.value && index < inputs.length - 1) {
                            inputs[index + 1].focus();
                        }
                        updateHiddenCode();
                    });

                    input.addEventListener('keydown', function (event) {
                        if (event.key === 'Backspace' && !this.value && index > 0) {
                            inputs[index - 1].focus();
                        }
                    });
                });

                form.addEventListener('submit', function () {
                    updateHiddenCode();
                });
            }
        })();
    </script>
}
