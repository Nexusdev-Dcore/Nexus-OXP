@model TaskFormViewModel
@{
    ViewData["Title"] = "Create Task";
}

<div class="dashboard-page">
    <section class="dashboard-header">
        <div class="dashboard-header-content">
            <div>
                <span class="section-label">Tasks</span>
                <h1>Create Task</h1>
                <p>Add work to a project with ownership, status, priority, and deadline.</p>
            </div>
        </div>
    </section>

    <section class="dashboard-section">
        <div class="dashboard-card">
            <form asp-action="Create" method="post" class="project-form">
                @Html.AntiForgeryToken()
                <partial name="_TaskForm" model="Model" />

                <div class="form-actions">
                    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-primary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create Task</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
