@model Team
@{
    ViewData["Title"] = Model.Name;
    var canManageTeam = ViewBag.CanManageTeam is true;
    var memberForm = ViewBag.MemberForm as TeamMemberFormViewModel ?? new TeamMemberFormViewModel { TeamId = Model.Id };
    var projectOptions = ViewBag.ProjectOptions as IReadOnlyList<SelectListItem> ?? [];
}

<div class="dashboard-page">
    <section class="dashboard-header">
        <div class="dashboard-header-content">
            <div>
                <span class="section-label">Team Details</span>
                <h1>@Model.Name</h1>
                <p>@(Model.Description ?? "No description has been added yet.")</p>
            </div>

            <div class="dashboard-header-actions">
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i>
                    Teams
                </a>

                @if (canManageTeam)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil"></i>
                        Edit
                    </a>

                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                        <i class="bi bi-trash"></i>
                        Delete
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="dashboard-stats">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <article class="dashboard-stat-card">
                    <span class="stat-title">Manager</span>
                    <h2 class="stat-value stat-value-sm">@Model.Manager.FirstName @Model.Manager.LastName</h2>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="dashboard-stat-card">
                    <span class="stat-title">Members</span>
                    <h2 class="stat-value">@Model.Members.Count</h2>
                </article>
            </div>
            <div class="col-lg-4 col-md-6">
                <article class="dashboard-stat-card">
                    <span class="stat-title">Projects</span>
                    <h2 class="stat-value">@Model.Projects.Count</h2>
                </article>
            </div>
        </div>
    </section>

    <section class="dashboard-content">
        <div class="row g-4">
            <div class="col-xl-7">
                <div class="dashboard-card">
                    <div class="dashboard-card-header">
                        <div>
                            <h2>Members</h2>
                            <p>People attached to this team.</p>
                        </div>
                    </div>

                    <div class="activity-list">
                        @foreach (var member in Model.Members.OrderBy(member => member.Role).ThenBy(member => member.User.FirstName))
                        {
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="bi bi-person"></i>
                                </div>
                                <div class="activity-content">
                                    <strong>@member.User.FirstName @member.User.LastName</strong>
                                    <p>@member.Role</p>
                                    <span>@member.User.Email</span>
                                </div>

                                @if (canManageTeam && member.UserId != Model.ManagerId)
                                {
                                    <form asp-action="RemoveMember" method="post" class="inline-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="teamId" value="@Model.Id" />
                                        <input type="hidden" name="memberId" value="@member.Id" />
                                        <button type="submit" class="btn btn-sm btn-light" aria-label="Remove member">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-5">
                @if (canManageTeam)
                {
                    <div class="dashboard-card">
                        <div class="dashboard-card-header">
                            <div>
                                <h2>Add Member</h2>
                                <p>Add an active user to this team.</p>
                            </div>
                        </div>

                        <form asp-action="AddMember" method="post" class="stacked-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="TeamId" value="@Model.Id" />

                            <label class="form-label" for="UserId">User</label>
                            <select id="UserId" name="UserId" asp-items="memberForm.UserOptions" class="form-select">
                                <option value="">Select user</option>
                            </select>

                            <label class="form-label" for="Role">Role</label>
                            <select id="Role" name="Role" asp-items="Html.GetEnumSelectList<TeamMemberRole>()" class="form-select"></select>

                            <button type="submit" class="btn btn-primary">Add Member</button>
                        </form>
                    </div>

                    <div class="dashboard-card mt-4">
                        <div class="dashboard-card-header">
                            <div>
                                <h2>Assign Project</h2>
                                <p>Attach an unassigned project to this team.</p>
                            </div>
                        </div>

                        <form asp-action="AssignProject" method="post" class="stacked-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="teamId" value="@Model.Id" />

                            <label class="form-label" for="projectId">Project</label>
                            <select id="projectId" name="projectId" asp-items="projectOptions" class="form-select">
                                <option value="">Select project</option>
                            </select>

                            <button type="submit" class="btn btn-primary">Assign Project</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="dashboard-section">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <div>
                    <h2>Projects</h2>
                    <p>Projects currently assigned to this team.</p>
                </div>
            </div>

            @if (Model.Projects.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                    <h3>No assigned projects</h3>
                    <p>Assigned projects will appear here.</p>
                </div>
            }
            else
            {
                <div class="activity-list">
                    @foreach (var project in Model.Projects.OrderBy(project => project.Name))
                    {
                        <div class="activity-item">
                            <div class="activity-icon">
                                <i class="bi bi-folder2-open"></i>
                            </div>
                            <div class="activity-content">
                                <strong>@project.Name</strong>
                                <p>@project.Status</p>
                                <span>@(project.Deadline?.ToString("MMM d, yyyy") ?? "No deadline")</span>
                            </div>
                            <a asp-controller="Projects" asp-action="Dashboard" asp-route-id="@project.Id" class="btn btn-sm btn-light">
                                <i class="bi bi-speedometer2"></i>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>
