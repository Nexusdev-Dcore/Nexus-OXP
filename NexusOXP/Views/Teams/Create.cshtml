@model TeamFormViewModel
@{
    ViewData["Title"] = "Create Team";
}

<div class="dashboard-page">
    <section class="dashboard-header">
        <div class="dashboard-header-content">
            <div>
                <span class="section-label">Teams</span>
                <h1>Create Team</h1>
                <p>Group members under a manager and optionally assign a project.</p>
            </div>
        </div>
    </section>

    <section class="dashboard-section">
        <div class="dashboard-card">
            <form asp-action="Create" method="post" class="project-form">
                @Html.AntiForgeryToken()
                <partial name="_TeamForm" model="Model" />

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create Team</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
