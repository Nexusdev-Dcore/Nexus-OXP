@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-hero">
    <div class="container">
        <div class="page-hero-content">

            <span class="section-label">Legal</span>

            <h1>Privacy Policy</h1>

            <p>
                Information about how we collect, use and protect
                your information.
            </p>

        </div>
    </div>
</section>


<section class="legal-section">
    <div class="container">

        <div class="legal-content">

            <div class="legal-section-block">
                <h2>1. Information We Collect</h2>

                <p>
                    We may collect information that you provide when
                    creating an account, contacting us or using our
                    services.
                </p>
            </div>


            <div class="legal-section-block">
                <h2>2. How We Use Your Information</h2>

                <p>
                    Information may be used to provide and improve our
                    services, maintain your account and communicate
                    with you.
                </p>
            </div>


            <div class="legal-section-block">
                <h2>3. Data Security</h2>

                <p>
                    We take reasonable measures to protect your
                    information against unauthorized access,
                    modification or disclosure.
                </p>
            </div>


            <div class="legal-section-block">
                <h2>4. Your Rights</h2>

                <p>
                    Depending on your location, you may have rights
                    regarding access, correction or deletion of your
                    personal information.
                </p>
            </div>


            <div class="legal-section-block">
                <h2>5. Contact</h2>

                <p>
                    If you have questions regarding this policy,
                    please contact us through our Contact page.
                </p>
            </div>

        </div>

    </div>
</section>
