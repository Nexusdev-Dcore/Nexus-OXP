@{
    ViewData["Title"] = "About";
}

<section class="page-hero">
    <div class="container">
        <div class="page-hero-content">

            <span class="section-label">About Us</span>

            <h1>Built with simplicity in mind.</h1>

            <p>
                Learn more about our platform, our purpose
                and the experience we want to create.
            </p>

        </div>
    </div>
</section>


<section class="about-section">
    <div class="container">

        <div class="row g-5 align-items-center">

            <div class="col-lg-6">
                <div class="content-block">

                    <span class="section-label">Our Story</span>

                    <h2>Technology should make things easier.</h2>

                    <p>
                        Our platform was created with one simple idea:
                        give users powerful tools without unnecessary
                        complexity.
                    </p>

                    <p>
                        From managing information to monitoring activity,
                        every part of the experience is designed to be
                        clear, fast and accessible.
                    </p>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="about-image-placeholder">
                    <span>Platform</span>
                </div>
            </div>

        </div>

    </div>
</section>


<section class="values-section">
    <div class="container">

        <div class="section-header">
            <span class="section-label">Our Values</span>
            <h2>What we believe in</h2>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <article class="value-card">
                    <h3>Simplicity</h3>
                    <p>
                        Clear interfaces and straightforward experiences.
                    </p>
                </article>
            </div>

            <div class="col-md-4">
                <article class="value-card">
                    <h3>Security</h3>
                    <p>
                        Protecting user information is one of our priorities.
                    </p>
                </article>
            </div>

            <div class="col-md-4">
                <article class="value-card">
                    <h3>Innovation</h3>
                    <p>
                        Continuously improving the way people use technology.
                    </p>
                </article>
            </div>

        </div>

    </div>
</section>
