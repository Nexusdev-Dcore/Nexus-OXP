@model Project
@{
    ViewData["Title"] = "Delete Project";
}

<div class="dashboard-page">
    <section class="dashboard-header">
        <div class="dashboard-header-content">
            <div>
                <span class="section-label">Projects</span>
                <h1>Delete Project</h1>
                <p>This action permanently removes the project and its membership records.</p>
            </div>
        </div>
    </section>

    <section class="dashboard-section">
        <div class="dashboard-card">
            <div class="delete-summary">
                <h2>@Model.Name</h2>
                <p>@(Model.Description ?? "No description")</p>

                <dl class="project-detail-list">
                    <dt>Owner</dt>
                    <dd>@Model.Owner.FirstName @Model.Owner.LastName</dd>

                    <dt>Status</dt>
                    <dd>@Model.Status</dd>

                    <dt>Priority</dt>
                    <dd>@Model.Priority</dd>
                </dl>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
                @Html.AntiForgeryToken()
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">Cancel</a>
                <button type="submit" class="btn btn-danger">Delete Project</button>
            </form>
        </div>
    </section>
</div>
